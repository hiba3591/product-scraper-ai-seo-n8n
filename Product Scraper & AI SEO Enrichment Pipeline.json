        "responses": {
          "values": [
            {
              "content": "=You are an expert e-commerce SEO copywriter.\n\nProduct Info:\nTitle: {{ $json.clean_title }}\nDescription: {{ $json.clean_description }}\nPrice: {{ $json.raw_price }}\n\nTransform into high-converting listing.\nRules:\n1. Title max 60 chars, no competitor brand\n2. description_html with <h3>, <p>, <ul><li>\n3. meta_title 50-60 chars\n4. meta_description 140-155 chars with CTA\n5. tags 5-8\n6. handle kebab-case\n\nRespond ONLY with valid JSON:\n{\"title\":\"\",\"description_html\":\"\",\"meta_title\":\"\",\"meta_description\":\"\",\"tags\":[],\"handle\":\"\"}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        896,
        0
      ],
      "id": "d5fb30b2-2cd7-4d69-b50e-45c33fb4901e",
      "name": "Message a model",
      "credentials": {

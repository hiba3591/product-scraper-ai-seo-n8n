    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst form = $('On form submission').first().json;\nconst base = String(form['Product URL'] || '').trim();\n\nreturn items.map(item => {\n  const raw = item.json;\n\n  let images = raw.image_urls || [];\n  if (!Array.isArray(images)) images = [images];\n\n  const fixed = images\n    .map(u => {\n      try { return new URL(String(u).trim(), base).href; }\n      catch (e) { return ''; }\n    })\n    .filter(u => u.startsWith('http'));\n\n  return {\n    json: {\n      source_url: base,\n      clean_title: String(raw.title || '').trim(),\n      clean_description: String(raw.description || '')\n        .replace(/<[^>]*>/g, ' ')\n        .replace(/\\s+/g, ' ')\n        .trim(),\n      raw_price: String(raw.price || '').replace(/[^0-9.]/g, ''),\n      debug_input_keys: Object.keys(raw),\n      debug_image_urls: raw.image_urls,\n      gallery_images: [...new Set(fixed)].slice(0, 5)\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "e6ce96bc-92fb-4965-b61e-87099da9d306",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst prev = $('Code in JavaScript').first().json;\n\nreturn items.map(item => {\n  const j = item.json;\n  let text = '';\n\n  if (Array.isArray(j.output) && j.output[0]?.content) {\n    const c = j.output[0].content;\n    text = Array.isArray(c) ? (c[0]?.text || c[0]?.content || '') : (c.text || c);\n  } else if (typeof j.message?.content === 'string') {\n    text = j.message.content;\n  } else if (Array.isArray(j.message?.content)) {\n    text = j.message.content.map(x => x.text || x.content || '').join('');\n  } else if (typeof j.output === 'string') {\n    text = j.output;\n  } else if (typeof j.text === 'string') {\n    text = j.text;\n  }\n\n  if (typeof text !== 'string') text = JSON.stringify(text || '');\n\n  const clean = text.replace(/```json|```/g, '').trim();\n\n  let out;\n  try {\n    out = JSON.parse(clean);\n  } catch (e) {\n    throw new Error('AI ne valid JSON nahi diya: ' + clean.slice(0, 200));\n  }\n\n  const tags = Array.isArray(out.tags)\n    ? out.tags\n    : String(out.tags || '').split(',').map(t => t.trim()).filter(Boolean);\n\n  return {\n    json: {\n      title: String(out.title || '').slice(0, 60),\n      description_html: out.description_html || '',\n      meta_title: out.meta_title || '',\n      meta_description: out.meta_description || '',\n      tags,\n      tags_string: tags.join(', '),\n      handle: out.handle || '',\n      source_url: prev.source_url,\n      raw_price: prev.raw_price,\n      gallery_images: prev.gallery_images,\n      images: (prev.gallery_images || []).map(src => ({ src }))\n    }\n  };\n});"
      },
